# ============================================================================
# HeartKart Cloud Backend — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit the actual .env file to version control.
#
# NOTE: When running as an AWS Lambda function, environment variables are set
# via the Lambda console / CloudFormation — not from a .env file. This file
# is only used when running app_agentcore.py locally for testing.
# ============================================================================

# ---------------------------------------------------------------------------
# AWS Configuration
# ---------------------------------------------------------------------------
# Region where AgentCore agents, DynamoDB, and Bedrock are hosted.
# Default: us-east-1
# AWS_REGION=us-east-1

# AWS CLI profile name that has access to the heartkart-deploy account (583880312323).
# Used when running app_agentcore.py locally. Ignored in Lambda (uses IAM role).
# Default: heartkart-deploy
# AWS_PROFILE_AGENTCORE=heartkart-deploy

# ---------------------------------------------------------------------------
# Vendor Caller EC2 Service
# ---------------------------------------------------------------------------
# HTTPS URL of the Vendor Caller server running on EC2.
# This server handles Twilio ↔ Nova Sonic audio bridging.
# Default: https://34-204-233-141.sslip.io
# VENDOR_CALLER_URL=https://34-204-233-141.sslip.io

# ---------------------------------------------------------------------------
# Twilio Configuration (required for vendor voice calls)
# ---------------------------------------------------------------------------
# Get these from https://console.twilio.com/
# Your Twilio Account SID (starts with "AC")
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here

# Your Twilio Auth Token
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your Twilio phone number (purchased from Twilio, E.164 format)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ---------------------------------------------------------------------------
# Optional / Advanced
# ---------------------------------------------------------------------------
# Set to "1" to enable Flask debug mode with auto-reload (local only)
# FLASK_DEBUG=0

# Backend API URL used by internal modules
# API_URL=http://localhost:5000

# ============================================================================
# HeartKart Frontend — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit the actual .env.local file to version control.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ============================================================================

# ---------------------------------------------------------------------------
# Vendor Call UI
# ---------------------------------------------------------------------------
# Phone number displayed in the "Call Vendor" modal for reference.
# This is the number that receives test vendor calls.
NEXT_PUBLIC_TEST_PHONE=+91XXXXXXXXXX

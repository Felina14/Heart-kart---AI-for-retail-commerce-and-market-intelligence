# ============================================================================
# HeartKart Local Backend — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit the actual .env file to version control.
# ============================================================================

# ---------------------------------------------------------------------------
# AWS Configuration
# ---------------------------------------------------------------------------
# Region where DynamoDB tables and Bedrock models are hosted.
# Default: us-east-1 (used automatically if not set)
# AWS_REGION=us-east-1

# DynamoDB table name for product catalog.
# Default: valentines-products (used automatically if not set)
# PRODUCTS_TABLE_NAME=valentines-products

# ---------------------------------------------------------------------------
# Twilio Configuration (required for vendor voice calls)
# ---------------------------------------------------------------------------
# Get these from https://console.twilio.com/
# Your Twilio Account SID (starts with "AC")
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here

# Your Twilio Auth Token
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your Twilio phone number (purchased from Twilio, E.164 format)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ---------------------------------------------------------------------------
# Phone Numbers for Testing
# ---------------------------------------------------------------------------
# The phone number that will RECEIVE test calls (your personal phone).
# Must be a Twilio-verified number if using a Twilio trial account.
# Verify at: https://console.twilio.com/ → Phone Numbers → Verified Caller IDs
TEST_PHONE_NUMBER=+91XXXXXXXXXX
VERIFIED_PHONE_NUMBER=+91XXXXXXXXXX

# ---------------------------------------------------------------------------
# Ngrok Configuration (required for vendor voice calls)
# ---------------------------------------------------------------------------
# After starting ngrok (ngrok http 8080), paste the HTTPS forwarding URL here.
# This tunnels Twilio's audio stream to your local WebSocket server.
# Example: https://abc123.ngrok-free.dev
NGROK_URL=https://your-subdomain.ngrok-free.dev

# ---------------------------------------------------------------------------
# Currency
# ---------------------------------------------------------------------------
# USD to INR exchange rate used for price display conversion.
# Update this to the current rate.
USD_TO_INR=89.62

# ---------------------------------------------------------------------------
# Optional / Advanced (defaults are fine for most setups)
# ---------------------------------------------------------------------------
# Set to "1" to enable Flask debug mode with auto-reload
# FLASK_DEBUG=0

# Pricing agent cache TTL in seconds (default: 60)
# PRICING_CACHE_TTL_SECONDS=60

# Pricing agent request timeout in seconds (default: 60)
# PRICING_TIMEOUT_SECONDS=60

# Max products to scan for replenishment (default: 1500)
# REPLENISHMENT_SCAN_LIMIT=1500

# Max replenishment recommendations to return (default: 100)
# REPLENISHMENT_TAKE_LIMIT=100

# AI recommendation timeout in seconds (default: 15)
# REPLENISHMENT_AI_TIMEOUT_SECONDS=15

# Delay between vendor fallback call attempts in seconds (default: 5)
# NEXT_VENDOR_DELAY_SECONDS=5

# Timeout for call ringing before giving up in seconds (default: 90)
# CALL_RINGING_TIMEOUT=90

# Backend API URL (used internally by vendor caller agents)
# API_URL=http://localhost:5000
